# Same Page — TLS front door. {$SP_DOMAIN} comes from the environment
# (docker-compose passes it). Caddy obtains and auto-renews a Let's Encrypt
# certificate, redirects HTTP→HTTPS, and reverse-proxies to the app.
#
# reverse_proxy forwards the original Host header and sets X-Forwarded-*
# by default — the app's CSRF check needs the real Host, so do NOT override it.

{$SP_DOMAIN} {
	encode gzip

	reverse_proxy app:8000 {
		# Defaults already forward Host + X-Forwarded-Proto/-For. Streaming is
		# left unbuffered so future Server-Sent-Events endpoints work; the
		# current app uses htmx polling, so this is forward-looking.
		flush_interval -1
	}
}
